{
  "name": "s2-report-sniffer-desktop",
  "version": "1.2.10",
  "description": "S2 Report Sniffer — Local SingleStore Cluster Report Analyzer",
  "author": "S2 Team",
  "homepage": "https://github.com/shahidstermain/S2-report-sniffer",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:unsigned": "CSC_LINK= APPLE_TEAM_ID= WINDOWS_CERT_PATH= electron-builder",
    "dist:portable": "electron-builder -- portable",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac:publish": "electron-builder --mac --publish onTagOrDraft",
    "dist:win:publish": "electron-builder --win --publish onTagOrDraft",
    "dist:linux:publish": "electron-builder --linux --publish onTagOrDraft"
  },
  "dependencies": {
    "electron-log": "^5.3.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.s2reportsniffer.app",
    "productName": "S2 Report Sniffer",
    "icon": "assets/icon",
    "afterPack": "./fix-permissions.js",
    "afterSign": "./after-sign-verify.js",
    "files": [
      "main.js",
      "preload.js",
      "assets/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../frontend/build",
        "to": "ui"
      },
      {
        "from": "../dist/backend",
        "to": "backend"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "maintainer": "S2 Team"
    },
    "publish": {
      "provider": "github",
      "owner": "shahidstermain",
      "repo": "S2-report-sniffer"
    },
    "portable": {
      "artifactName": "S2ReportSniffer-Portable-${version}.${ext}"
    }
  }
}
