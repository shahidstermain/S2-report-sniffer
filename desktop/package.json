{
  "name": "s2-report-sniffer-desktop",
  "version": "1.0.0",
  "description": "S2 Report Sniffer — Cluster Diagnostic Tool for SingleStore",
  "author": "S2 Team",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:unsigned": "CSC_LINK= APPLE_TEAM_ID= WINDOWS_CERT_PATH= electron-builder",
    "dist:portable": "electron-builder -- portable",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-log": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.s2reportsniffer.app",
    "productName": "S2 Report Sniffer",
    "icon": "assets/icon",
    "files": [
      "main.js",
      "assets/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../frontend/build",
        "to": "ui"
      },
      {
        "from": "../dist/backend",
        "to": "backend"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "sign": "${env.CSC_LINK}",
      "notarize": {
        "teamId": "${env.APPLE_TEAM_ID}"
      }
    },
    "win": {
      "target": [
        "msi"
      ],
      "sign": "${env.WINDOWS_CERT_PATH}",
      "signingHashAlgorithms": ["sha256"]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "maintainer": "S2 Team"
    },
    "portable": {
      "artifactName": "S2ReportSniffer-Portable-${version}.${ext}"
    }
  }
}
