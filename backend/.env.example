# S2 Report Sniffer Backend Environment Variables
# ------------------------------------------------
# Copy this file to .env and fill in the values as needed.

# --- Core Application Settings ---

# Storage backend to use. "local" (default) uses SQLite and the local filesystem.
# "postgres" is a planned option but not yet implemented.
STORAGE_BACKEND=local

# Overrides the default local data directory (~/.s2-report-sniffer).
# Use an absolute path.
# S2RS_DATA_DIR=/path/to/your/data

# --- Server Configuration ---

# Host and port for the backend server. Only used by desktop_entry.py for PyInstaller builds.
# Gunicorn uses the BIND variable below.
S2RS_HOST=127.0.0.1
S2RS_PORT=8000

# Log level for the application. Can be 'debug', 'info', 'warning', 'error'.
S2RS_LOG_LEVEL=info

# Comma-separated list of allowed CORS origins (read from S2RS_CORS_ORIGINS).
# When unset the server denies all cross-origin requests (secure default).
# Wildcards are rejected; list explicit origins for any hosted deployment.
S2RS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security Settings ---

# os.pathsep-separated list of base directories reports may be imported from.
# Defense-in-depth against arbitrary local filesystem reads via /api/reports/import.
# When unset, imports are confined to the server's current working directory.
# Example (POSIX): S2RS_IMPORT_ALLOWED_PATHS=/Users/me/Downloads:/mnt/shared/reports
S2RS_IMPORT_ALLOWED_PATHS=

# Set to "1"/"true" to fully disable the local import endpoint.
S2RS_DISABLE_LOCAL_IMPORT=0

# --- Feature Flags & Debugging ---

# Set to "1" or "true" to enable optional cloud extension routes (e.g., /api/hostinger/*).
# Disabled by default for local-first/air-gapped deployments.
# Analyze in Glean (incident packet export) does not require this flag.
S2RS_ENABLE_CLOUD_EXTENSIONS=0

# --- Cloud Integrations (Optional) ---

# API token for the Hostinger VPS API. Required if cloud extensions are enabled.
HOSTINGER_API_TOKEN=